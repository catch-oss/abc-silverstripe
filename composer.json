{
  "name": "azt3k/abc-silverstripe",
  "description": "Library that adds some useful functionality to Silverstripe",
  "license": "BSD-3-Clause-Clear",
  "type": "silverstripe-vendormodule",
  "authors": [
    {
      "name": "Aaron Latham-Ilari",
      "email": "az@catchdesign.co.nz"
    }
  ],
  "prefer-stable": true,
  "minimum-stability": "dev",
  "require": {
    "php": "^8.5",
    "silverstripe/framework": "^6.0",
    "silverstripe/cms": "^6.0",
    "silverstripe/crontask": "^4.0",
    "silverstripe/vendor-plugin": "^3.0",
    "psr/simple-cache": "^3.0",
    "composer/installers": "^2.2"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "silverstripe/recipe-cms": "^6.0"
  },
  "autoload": {
    "psr-4": {
      "Azt3k\\SS\\": "src/abc/code/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Azt3k\\SS\\Tests\\": "tests/"
    },
    "classmap": [
      "app/src/Page.php",
      "app/src/PageController.php"
    ]
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "silverstripe/vendor-plugin": true,
      "silverstripe/recipe-plugin": true
    }
  }
}
